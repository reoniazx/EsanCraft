[Desktop Entry]
Type=Application
Name=SoundThai
GenericName=Digital Audio Workstation
Comment=Record, edit and mix audio and MIDI
Exec=soundthai %F
TryExec=soundthai
Icon=ai.storyteller.soundthai
Terminal=false
